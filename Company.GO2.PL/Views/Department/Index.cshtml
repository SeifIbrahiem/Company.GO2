@using Microsoft.VisualBasic
@model IEnumerable<Department>
@{
    ViewData["Title"] = "Index";
}

<h1>All Department</h1>

<br/>
<br/>

<a asp-action="Create" asp-controller="Department"class="btn btn-primary">Create Department</a>

<br />
<br />

@if (Model.Count() > 0)
{

    <table class="table table-hover table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Date of creation</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>item.code</td>
                    <td>item.Name</td>
                    <td>item.Createat</td>
                    <td>
                        <a asp-action="Detailes" class="btn btn-warning">Deatailes</a>
                    </td>
                    <td>
                        <a asp-action="Edit" class="btn btn-warning">Update</a>
                    </td>
                    <td>
                        <a asp-action="Delete" class="btn btn-warning">Delete</a>
                    </td>
                </tr>
            }
        </tbody>


    </table>





}
else 
{
    <div class="mt_4 alert alert-info">
        <h4>THERE Are NO Department:(</h4>
    </div>
}